pipeline {
    agent any 
    stages {
        stage('Existing Shell Script') {
            steps {
                // Call your bash script directly
                //sh 'bash my_reporting_script.sh'
                sh '''
                pwd
                ls -la
                sed -i 's/\r$//' my_reporting_script.sh
                bash my_reporting_script.sh
                '''
            }
        }
        stage('Existing Python Script') {
            steps {
                // Call your python script directly
                sh 'python my_automation.py'
            }
        }
    }
}
